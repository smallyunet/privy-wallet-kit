{
  "name": "privy-wallet-kit",
  "version": "0.0.10",
  "description": "Maintenance-mode React components and hooks for Privy-connected EVM wallets.",
  "repository": {
    "type": "git",
    "url": "https://github.com/smallyunet/privy-wallet-kit"
  },
  "homepage": "https://github.com/smallyunet/privy-wallet-kit#readme",
  "bugs": "https://github.com/smallyunet/privy-wallet-kit/issues",
  "type": "module",
  "main": "dist/privy-wallet-kit.umd.cjs",
  "module": "dist/privy-wallet-kit.js",
  "types": "dist/index.d.ts",
  "style": "dist/privy-wallet-kit.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/privy-wallet-kit.js",
      "require": "./dist/privy-wallet-kit.umd.cjs"
    },
    "./style.css": "./dist/privy-wallet-kit.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "qrcode.react": "^4.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.1",
    "@privy-io/react-auth": "^3.37.1",
    "@storybook/addon-a11y": "^10.1.8",
    "@storybook/addon-docs": "^10.1.8",
    "@storybook/addon-onboarding": "^10.1.8",
    "@storybook/addon-vitest": "^10.1.8",
    "@storybook/react-vite": "^10.1.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "storybook": "^10.1.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "viem": "2.55.13",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@privy-io/react-auth": "^3.8.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "viem": "^2.41.2"
  }
}
